# ============================================
# BINANCE API (required for REST mode)
# ============================================
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# hedge | oneway (optional; auto-detected if unset)

# ============================================
# TELEGRAM (optional)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# SYMBOLS & WEBSOCKET
# ============================================
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DEPTH=10
WS_SPEED=500ms

# ============================================
# ORDER EXECUTION: rest | finandy
# ============================================
ORDER_EXECUTION_MODE=rest

# ============================================
# RISK & SIGNALS
# ============================================
POSITION_SIZE_USDT=50
LEVERAGE=5
TP_PERCENT=0.5
SL_PERCENT=0.4
# percent = TP/SL by % from entry | ob_grid = structural walls (SHORT SL=R1 TP=S0, LONG SL=S1 TP=R0)
TP_SL_MODE=percent
OB_WALL_SHIFT_PCT=0.25
SL_OB_BUFFER_PCT=0.05
TP_OB_BUFFER_PCT=0.05
OB_GRID_MIN_SL_PCT=0.4
OB_GRID_MIN_R0_R1_GAP_PCT=0.2
OB_GRID_SL_RANGE_RATIO=0.382
MIN_CONFIDENCE=50
ORDER_COOLDOWN=300

VOLATILE_THRESHOLD=15
SL_VOLATILE_MIN=0.8
TP_VOLATILE_MIN=1.0
MIN_SL_SPREAD_MULT=3

# ============================================
# TRADING SCHEDULE (UTC, same as trade-deepseek)
# ============================================
TRADING_SCHEDULE_ENABLED=true
EXECUTION_HOUR_START=0
EXECUTION_HOUR_END=23
ALLOWED_DAYS=1,2,3,4,5,6,7

# ============================================
# ORDER BOOK BEHAVIOUR
# ============================================
REPLACE_STALE_LIMITS=true
CLOSE_ON_OPPOSITE=true
ZONE_UPPER_PCT=75
ZONE_LOWER_PCT=25

# REST: SL/TP on Binance after entry LIMIT fills (required for initial SL; lock-profit can move it later)
REST_PLACE_SL_TP=true
REST_SL_TP_FILL_WAIT=90
REST_SL_TP_POLL_INTERVAL=2

# Lock profit: at LOCK_PROFIT_BE_PCT% toward TP, move SL to LOCK_PROFIT_SL_AT_PCT% of entry→TP
LOCK_PROFIT_ENABLED=true
LOCK_PROFIT_BE_PCT=50
LOCK_PROFIT_SL_AT_PCT=20
LOCK_PROFIT_BUFFER_PCT=0.05
LOCK_PROFIT_STAGE2_PCT=0

BINANCE_MIN_POSITION_USDT=1.0

# ============================================
# FINANDY (fallback when ORDER_EXECUTION_MODE=finandy)
# ============================================
FINANDY_SECRET=
FINANDY_WEBHOOK=https://hook.finandy.com/your-hook-id

# ============================================
# TERMINAL & LOGS (optional overrides)
# ============================================
